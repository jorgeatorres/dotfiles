[color]
    ui = auto
[column]
	ui = auto
[core]
    editor = /usr/bin/vim
    excludesfile = ~/.gitignore
[credential]
    helper = osxkeychain
[push]
    default = current
	#default = nothing
	autoSetupRemote = true
[fetch]
	prune = true
	#pruneTags = true
[commit]
	verbose = true
[diff]
	algorithm = histogram
    compactionHeuristic = true
	colorMoved = zebra
	mnemonicPrefix = true
	renames = true
[branch]
	sort = -committerdate
# [rerere]
#	enabled = true
#	autoupdate = true
[rebase]
	autoStash = true
	autoSquash = true
[tag]
	sort = v:refname
[alias]
	c = commit
	d = diff
	l = log --oneline
    a = add
    p = push
    s = status
	ls = ls-files
	pr = pull --rebase
	uncommit = reset --soft HEAD^
	unstage = reset HEAD
    br = branch
    co = checkout
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = trunk
[merge]
	conflictStyle = zdiff3
[include]
	path = .user.gitconfig
	path = .work.gitconfig
