{
    "workbench.statusBar.feedback.visible": false,
    "editor.find.globalFindClipboard": true,
    "editor.minimap.enabled": false,
    "editor.selectionHighlight": true,
    "editor.rulers": [120],
    "editor.wordWrap": "off",
    "editor.renderLineHighlight": "all",
    "editor.multiCursorModifier": "alt",
    "editor.formatOnType": true,
    "editor.formatOnPaste": false,
    "editor.renderWhitespace": "none",
    "editor.scrollBeyondLastLine": false,
    "editor.showUnused": true,
    "editor.suggest.showStatusBar": true,
    "telemetry.telemetrySetting": "off",
    "workbench.startupEditor": "newUntitledFile",
    "git.autofetch": true,
    "workbench.editor.revealIfOpen": true,
    "files.insertFinalNewline": true,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "search.smartCase": true,
    "php.suggest.basic": false,
    "javascript.format.enable": false,
    "git.promptToSaveFilesBeforeCommit": "always",
    "editor.insertSpaces": false,
    "editor.cursorSurroundingLines": 4,
    "editor.fontWeight": "400",
    "editor.fontFamily": "Monolisa, Berkeley Mono Trial, Operator Mono, IBM Plex Mono, Jetbrains Mono, Input Mono Narrow, Monaco, monospace",
    "editor.fontSize": 10.5,
    "editor.fontLigatures": false,
    "window.titleBarStyle": "native",
    "window.customTitleBarVisibility": "never",
    "window.nativeTabs": true,
    "window.newWindowDimensions": "maximized",
    "window.commandCenter": true,
    "window.autoDetectColorScheme": false,
    "window.title": "${activeEditorMedium}${separator}${rootName}",
    "breadcrumbs.enabled": true,
    "editor.matchBrackets": "near",
    "editor.bracketPairColorization.enabled": true,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.guides.indentation": true,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.renderControlCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.accessibilitySupport": "off",
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.tabActionLocation": "left",
    "workbench.editor.splitInGroupLayout": "vertical",
    "workbench.editor.enablePreviewFromCodeNavigation": true,
    "workbench.quickOpen.closeOnFocusLost": false,
    "workbench.colorTheme": "One Dark Pro",
    "explorer.openEditors.visible": 0,
    "files.restoreUndoStack": false,
    "files.trimTrailingWhitespace": true,
    "code-runner.enableAppInsights": false,
    "code-runner.temporaryFileName": "",
    "code-runner.clearPreviousOutput": true,
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.statusBar.enabled": false,
    "gitlens.defaultDateShortFormat": "YYYY-MMM-DD",
    "gitlens.defaultDateFormat": "YYYY-MM-DD HH:m",
    "gitlens.views.repositories.location": "gitlens",
    "gitlens.views.fileHistory.location": "gitlens",
    "gitlens.views.lineHistory.location": "gitlens",
    "gitlens.views.compare.location": "gitlens",
    "gitlens.views.search.location": "gitlens",
    "gitlens.views.lineHistory.enabled": false,
    "gitlens.currentLine.enabled": false,
    "git.blame.editorDecoration.enabled": false,
    "oneDarkPro.editorTheme": "Onedark Pro",
    "oneDarkPro.vivid": false,
    "php.debug.executablePath": "",
    "claudeCode.preferredLocation": "panel",
    "claudeCode.useTerminal": true
}
