#!/bin/bash

DIR="${1:-.}"
DURATION="${2:-3.5}"

if [[ ! -d "$DIR" ]]; then
	echo "Usage: $(basename "$0") [<dir>] [<seconds per image, default: 3.5>]"
	exit 1
fi

if ! command -v iina > /dev/null 2>&1; then
	echo "$(basename "$0"): iina not found (brew install --cask iina)" >&2
	exit 1
fi

shopt -s nullglob nocaseglob
MEDIA=("$DIR"/*.{jpg,jpeg,png,gif,heic,webp,mp4,m4v,mov,mkv,webm,avi})

if [[ ${#MEDIA[@]} -eq 0 ]]; then
	echo "$(basename "$0"): no images or videos in $DIR" >&2
	exit 1
fi

iina --mpv-shuffle --mpv-fullscreen --mpv-image-display-duration="$DURATION" --mpv-loop-playlist=inf "${MEDIA[@]}"
